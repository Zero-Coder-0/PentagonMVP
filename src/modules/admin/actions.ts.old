// =====================================================
// UNITS - BULK CREATE
// =====================================================

export async function bulkCreateUnitsV7(units: Partial<Unit>[]) {
  const supabase = await createClient();

  try {
    if (!units.length) {
      throw new Error('No units provided');
    }

    const { data, error } = await supabase.from('units').insert(units).select();

    if (error) throw error;

    return { success: true, data, count: data.length };
  } catch (error) {
    console.error('Failed to bulk create units:', error);
    return { success: false, error: (error as Error).message };
  }
}

// =====================================================
// PROJECT MEDIA - UPLOAD
// =====================================================

export async function createProjectMediaV7(mediaData: Partial<ProjectMedia>) {
  const supabase = await createClient();

  try {
    if (!mediaData.project_id || !mediaData.media_url) {
      throw new Error('Project ID and media URL are required');
    }

    const { data, error } = await supabase
      .from('project_media')
      .insert({
        project_id: mediaData.project_id,
        media_type: mediaData.media_type || 'Project Image',
        storage_provider: mediaData.storage_provider,
        media_url: mediaData.media_url,
        thumbnail_url: mediaData.thumbnail_url,
        display_order: mediaData.display_order || 0,
        is_primary: mediaData.is_primary || false,
        title: mediaData.title,
        file_size_kb: mediaData.file_size_kb,
      })
      .select()
      .single();

    if (error) throw error;

    return { success: true, data };
  } catch (error) {
    console.error('Failed to create project media:', error);
    return { success: false, error: (error as Error).message };
  }
}

// =====================================================
// PROJECT MEDIA - SET PRIMARY
// =====================================================

export async function setPrimaryMediaV7(mediaId: string, projectId: string) {
  const supabase = await createClient();

  try {
    // First, unset all primary media for this project
    await supabase.from('project_media').update({ is_primary: false }).eq('project_id', projectId);

    // Then set the new primary
    const { data, error } = await supabase
      .from('project_media')
      .update({ is_primary: true })
      .eq('id', mediaId)
      .select()
      .single();

    if (error) throw error;

    return { success: true, data };
  } catch (error) {
    console.error('Failed to set primary media:', error);
    return { success: false, error: (error as Error).message };
  }
}

// =====================================================
// PROJECT MEDIA - DELETE
// =====================================================

export async function deleteProjectMediaV7(mediaId: string) {
  const supabase = await createClient();

  try {
    const { error } = await supabase.from('project_media').delete().eq('id', mediaId);

    if (error) throw error;

    return { success: true };
  } catch (error) {
    console.error('Failed to delete project media:', error);
    return { success: false, error: (error as Error).message };
  }
}

// =====================================================
// HELPER FUNCTIONS
// =====================================================

function generateSlug(name: string): string {
  return name
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-');
}

// =====================================================
// NEARBY DATA - BATCH UPSERT
// =====================================================

export async function upsertSchoolsV7(projectId: string, schools: Array<{ school_name: string; distance_km?: string; travel_time?: string }>) {
  const supabase = await createClient();

  try {
    // Delete existing
    await supabase.from('schools_nearby').delete().eq('project_id', projectId);

    // Insert new
    if (schools.length > 0) {
      const { data, error } = await supabase
        .from('schools_nearby')
        .insert(schools.map((s) => ({ project_id: projectId, ...s })))
        .select();

      if (error) throw error;
      return { success: true, data };
    }

    return { success: true, data: [] };
  } catch (error) {
    console.error('Failed to upsert schools:', error);
    return { success: false, error: (error as Error).message };
  }
}

