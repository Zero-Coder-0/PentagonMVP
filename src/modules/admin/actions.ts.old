// =====================================================
// PROJECT ADDRESSES - UPSERT
// =====================================================

export async function upsertProjectAddressV7(projectId: string, addressData: Partial<ProjectAddress>) {
  const supabase = await createClient();

  try {
    // Check if address exists
    const { data: existing } = await supabase
      .from('project_addresses')
      .select('id')
      .eq('project_id', projectId)
      .maybeSingle();

    if (existing) {
      // Update
      const { data, error } = await supabase
        .from('project_addresses')
        .update({
          general_location: addressData.general_location,
          key_road_access: addressData.key_road_access,
          detailed_address: addressData.detailed_address,
          nearby_landmark: addressData.nearby_landmark,
        })
        .eq('id', existing.id)
        .select()
        .single();

      if (error) throw error;
      return { success: true, data };
    } else {
      // Insert
      const { data, error } = await supabase
        .from('project_addresses')
        .insert({
          project_id: projectId,
          general_location: addressData.general_location,
          key_road_access: addressData.key_road_access,
          detailed_address: addressData.detailed_address,
          nearby_landmark: addressData.nearby_landmark,
        })
        .select()
        .single();

      if (error) throw error;
      return { success: true, data };
    }
  } catch (error) {
    console.error('Failed to upsert project address:', error);
    return { success: false, error: (error as Error).message };
  }
}

// =====================================================
// UNIT TEMPLATES - CREATE
// =====================================================

export async function createUnitTemplateV7(templateData: Partial<UnitTemplate>) {
  const supabase = await createClient();

  try {
    if (!templateData.project_id || !templateData.template_name || !templateData.config_type) {
      throw new Error('Project ID, template name, and config type are required');
    }

    const { data, error } = await supabase
      .from('unit_templates')
      .insert({
        project_id: templateData.project_id,
        template_name: templateData.template_name,
        config_type: templateData.config_type,
        std_super_built_up_area: templateData.std_super_built_up_area,
        std_carpet_area: templateData.std_carpet_area,
        std_balcony_area: templateData.std_balcony_area,
        std_terrace_area: templateData.std_terrace_area,
        std_garden_area: templateData.std_garden_area,
        std_uds_area: templateData.std_uds_area,
        wc_count: templateData.wc_count,
        balcony_count: templateData.balcony_count,
        std_base_price: templateData.std_base_price,
        std_price_per_sqft: templateData.std_price_per_sqft,
        specifications: templateData.specifications || {},
        room_dimensions: templateData.room_dimensions || {},
        description: templateData.description,
        unit_strengths: templateData.unit_strengths,
        unit_drawbacks: templateData.unit_drawbacks,
        vastu_compliance: templateData.vastu_compliance,
        ventilation_quality: templateData.ventilation_quality,
      })
      .select()
      .single();

    if (error) throw error;

    return { success: true, data };
  } catch (error) {
    console.error('Failed to create unit template:', error);
    return { success: false, error: (error as Error).message };
  }
}

