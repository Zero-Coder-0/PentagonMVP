// =====================================================
// UNITS - CREATE
// =====================================================

export async function createUnitV7(unitData: Partial<Unit>) {
  const supabase = await createClient();

  try {
    if (!unitData.project_id || !unitData.unit_number || unitData.price_total == null) {
      throw new Error('Project ID, unit number, and price are required');
    }

    const { data, error } = await supabase
      .from('units')
      .insert({
        project_id: unitData.project_id,
        template_id: unitData.template_id,
        unit_number: unitData.unit_number,
        floor_number: unitData.floor_number,
        block_tower: unitData.block_tower,
        facing: unitData.facing,
        facing_available: unitData.facing_available,
        view_type: unitData.view_type,
        status: unitData.status || 'Available',
        is_available: unitData.is_available !== false,
        actual_sba: unitData.actual_sba,
        actual_carpet_area: unitData.actual_carpet_area,
        balcony_area: unitData.balcony_area,
        private_terrace_area: unitData.private_terrace_area,
        garden_area: unitData.garden_area,
        uds_area: unitData.uds_area,
        wc_count: unitData.wc_count,
        balcony_count: unitData.balcony_count,
        price_total: unitData.price_total,
        price_per_sqft: unitData.price_per_sqft,
        plc_charges: unitData.plc_charges,
        floor_rise_charges: unitData.floor_rise_charges,
        parking_charges: unitData.parking_charges,
        flooring_type: unitData.flooring_type,
        power_load_kw: unitData.power_load_kw,
        unit_specs: unitData.unit_specs || {},
        custom_features: unitData.custom_features || {},
        is_hot_selling: unitData.is_hot_selling || false,
        is_recommended: unitData.is_recommended || false,
        internal_notes: unitData.internal_notes,
      })
      .select()
      .single();

    if (error) throw error;

    return { success: true, data };
  } catch (error) {
    console.error('Failed to create unit:', error);
    return { success: false, error: (error as Error).message };
  }
}

